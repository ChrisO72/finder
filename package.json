{
  "name": "finder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "react-router dev",
    "dev:worker": "node --import tsx worker/index.ts",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "react-router build",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=esm --outfile=build/worker.js --packages=external",
    "start": "concurrently --kill-others-on-fail --names web,worker \"npm:start:web\" \"npm:start:worker\"",
    "start:web": "react-router-serve ./build/server/index.js",
    "start:worker": "node build/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "react-router typegen && tsc",
    "check": "react-router typegen && tsc && eslint . && prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:wipe": "docker compose down -v",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@mistralai/mistralai": "^1.14.1",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^6.0.0",
    "isbot": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lettermint": "^2.1.0",
    "motion": "^12.43.0",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "youtube-dl-exec": "^3.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
